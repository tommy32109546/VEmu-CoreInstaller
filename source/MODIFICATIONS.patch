+int PadButtonToGamepadButton(uint32_t pad_button) {
+	switch (pad_button) {
+		case Controller::PAD_BUTTON_L3: return SDL_GAMEPAD_BUTTON_LEFT_STICK;
+		case Controller::PAD_BUTTON_R3: return SDL_GAMEPAD_BUTTON_RIGHT_STICK;
+		case Controller::PAD_BUTTON_OPTIONS: return SDL_GAMEPAD_BUTTON_START;
+		case Controller::PAD_BUTTON_UP: return SDL_GAMEPAD_BUTTON_DPAD_UP;
+		case Controller::PAD_BUTTON_RIGHT: return SDL_GAMEPAD_BUTTON_DPAD_RIGHT;
+		case Controller::PAD_BUTTON_DOWN: return SDL_GAMEPAD_BUTTON_DPAD_DOWN;
+		case Controller::PAD_BUTTON_LEFT: return SDL_GAMEPAD_BUTTON_DPAD_LEFT;
+		case Controller::PAD_BUTTON_L1: return SDL_GAMEPAD_BUTTON_LEFT_SHOULDER;
+		case Controller::PAD_BUTTON_R1: return SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER;
+		case Controller::PAD_BUTTON_TRIANGLE: return SDL_GAMEPAD_BUTTON_NORTH;
+		case Controller::PAD_BUTTON_CIRCLE: return SDL_GAMEPAD_BUTTON_EAST;
+		case Controller::PAD_BUTTON_CROSS: return SDL_GAMEPAD_BUTTON_SOUTH;
+		case Controller::PAD_BUTTON_SQUARE: return SDL_GAMEPAD_BUTTON_WEST;
+		case Controller::PAD_BUTTON_TOUCH_PAD: return SDL_GAMEPAD_BUTTON_TOUCHPAD;
+		default: return SDL_GAMEPAD_BUTTON_INVALID;
+	}
+}
+
+int PadAxisToGamepadAxis(uint32_t axis) {
+	switch (axis) {
+		case 0: return SDL_GAMEPAD_AXIS_LEFTX;
+		case 1: return SDL_GAMEPAD_AXIS_LEFTY;
+		case 2: return SDL_GAMEPAD_AXIS_RIGHTX;
+		case 3: return SDL_GAMEPAD_AXIS_RIGHTY;
+		case 4: return SDL_GAMEPAD_AXIS_LEFT_TRIGGER;
+		case 5: return SDL_GAMEPAD_AXIS_RIGHT_TRIGGER;
+		default: return SDL_GAMEPAD_AXIS_INVALID;
+	}
+}
+
+int PadAxisValueToGamepadAxisValue(uint32_t axis, int value) {
+	const int clamped = std::clamp(value, 0, 255);
+	if (axis == 4 || axis == 5) {
+		return clamped * 128;
+	}
+	return std::clamp((clamped - 128) * 257, -32768, 32767);
+}
+
+} // namespace
+
+void ProcessLibretroOverlayButton(uint32_t pad_button, bool down) {
+	if (!g_input_active || !g_input_controller) {
+		return;
+	}
+	const int gamepad_button = PadButtonToGamepadButton(pad_button);
+	if (gamepad_button == SDL_GAMEPAD_BUTTON_INVALID) {
+		return;
+	}
+	QueueInput({InputKind::Button, g_input_session, gamepad_button, down ? 1.0f : 0.0f, 0.0f});
+}
+
+void ProcessLibretroOverlayAxis(uint32_t axis, int value) {
+	if (!g_input_active || !g_input_controller) {
+		return;
+	}
+	const int gamepad_axis = PadAxisToGamepadAxis(axis);
+	if (gamepad_axis == SDL_GAMEPAD_AXIS_INVALID) {
+		return;
+	}
+	QueueInput({InputKind::Axis, g_input_session, gamepad_axis,
+	            static_cast<float>(PadAxisValueToGamepadAxisValue(axis, value)), 0.0f});
+}
+
+bool IsSystemOverlayControllerCaptureActive() noexcept {
+	return g_input_active && g_input_controller;
+}
