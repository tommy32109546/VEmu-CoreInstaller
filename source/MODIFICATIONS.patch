+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+struct ExecuteThreadContext {
+	std::filesystem::path game_patch;
+};
+
+static DWORD WINAPI ExecuteThread(LPVOID parameter) {
+	std::unique_ptr<ExecuteThreadContext> context(static_cast<ExecuteThreadContext*>(parameter));
+	Common::Singleton<Loader::RuntimeLinker>::Instance()->Execute(context->game_patch);
+	return 0;
+}
+#endif
+
 static void Execute(const std::filesystem::path& game_patch) {
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	auto* context = new ExecuteThreadContext {game_patch};
+	const HANDLE thread = CreateThread(nullptr, 0x200000, ExecuteThread, context, 0, nullptr);
+	if (thread == nullptr) {
+		delete context;
+		EXIT("CreateThread failed: %lu\n", GetLastError());
+	}
+	CloseHandle(thread);
+#else
 	std::thread([game_patch] {
 		Common::Singleton<Loader::RuntimeLinker>::Instance()->Execute(game_patch);
 	}).detach();
+#endif
 	Libs::Graphics::WindowRun();
 	std::quick_exit(0);
 }
